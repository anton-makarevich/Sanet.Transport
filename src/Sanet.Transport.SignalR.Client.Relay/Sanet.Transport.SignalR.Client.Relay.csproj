<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RootNamespace>Sanet.Transport.SignalR.Client.Relay</RootNamespace>
    <AssemblyName>Sanet.Transport.SignalR.Client.Relay</AssemblyName>

    <!-- NuGet package properties -->
    <PackageId>Sanet.Transport.SignalR.Client.Relay</PackageId>
    <Description>Client SDK for the relay hub room-management REST API: room lifecycle client (create, join, ready, close, remove member), DTOs, and error types.</Description>
    <PackageProjectUrl>https://github.com/anton-makarevich/Sanet.Transport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anton-makarevich/Sanet.Transport</RepositoryUrl>
    <PackageTags>transport;signalr;relay;client;rooms</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <ProjectReference Include="..\Sanet.Transport.Relay.Contracts\Sanet.Transport.Relay.Contracts.csproj" />
  </ItemGroup>

</Project>
