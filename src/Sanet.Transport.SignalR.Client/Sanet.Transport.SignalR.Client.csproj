<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RootNamespace>Sanet.Transport.SignalR.Client</RootNamespace>
    <AssemblyName>Sanet.Transport.SignalR.Client</AssemblyName>
    
    <!-- NuGet package properties -->
    <PackageId>Sanet.Transport.SignalR.Client</PackageId>
    <Version>1.2.2</Version>
    <Authors>Anton Makarevich</Authors>
    <Company>Sanet</Company>
    <Description>Client components for SignalR implementation of the Sanet.Transport abstractions. Includes discovery and client publisher.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/anton-makarevich/Sanet.Transport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anton-makarevich/Sanet.Transport</RepositoryUrl>
    <PackageTags>transport;signalr;messaging;client;discovery</PackageTags>
    <!-- <PackageReadmeFile>README.md</PackageReadmeFile> --> <!-- Add a client-specific README -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanet.Transport\Sanet.Transport.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Sanet.Transport.SignalR.Tests</_Parameter1> <!-- Adjust if test project name changes -->
    </AssemblyAttribute>
     <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Sanet.Transport.SignalR.Client.Tests</_Parameter1> <!-- For new client tests -->
    </AssemblyAttribute>
  </ItemGroup>

</Project>
